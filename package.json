{
  "name": "@gengdy/mote",
  "version": "1.1.1",
  "description": "Practice vocabulary in the terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mote": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsc",
    "mote": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gengdy1545/Mote.git"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
